{
  "name": "@larasell-dev/ui",
  "version": "0.1.7",
  "description": "Bare React and Base UI design system for Larasell admin UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Larasell-dev/ui.git"
  },
  "files": [
    "dist",
    "src/*.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./icons": "./dist/icons.mjs",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "best-before": "sh scripts/best-before",
    "prepublishOnly": "vp run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "knip": "knip",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-icons/ri": "2.0.0",
    "@iconify/types": "2.0.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "knip": "^6.41.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "^1.2.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}

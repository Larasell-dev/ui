#!/bin/sh
# Fail when any text file contains a best-before date before today (UTC).
# Marker, in any language that allows the text: best-before: YYYY-MM-DD
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
today=$(date -u +%Y-%m-%d)
matches=$(mktemp)
trap 'rm -f "$matches"' EXIT

find "$root" \
    \( -name node_modules -o -name vendor -o -name dist -o -name .git -o -name storybook-static \) -prune \
    -o -type f -exec grep -I -H -n -E 'best-before:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}' {} + >"$matches" 2>/dev/null || true

fail=0
while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue

    file=${line%%:*}
    rest=${line#*:}
    content=${rest#*:}
    date=$(printf '%s\n' "$content" | sed -n 's/.*best-before:[[:space:]]*\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\).*/\1/p')

    [ -z "$date" ] && continue

    earliest=$(printf '%s\n%s\n' "$date" "$today" | sort | head -n 1)
    if [ "$earliest" = "$date" ] && [ "$date" != "$today" ]; then
        printf 'expired best-before %s in %s\n' "$date" "$file"
        fail=1
    fi
done <"$matches"

exit "$fail"
